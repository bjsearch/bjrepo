.feedback-item .delete-btn{position:absolute;top:6px;right:6px;background:none;border:none;color:var(--sub);cursor:pointer;font-size:16px;padding:0;width:20px;height:20px;display:flex;align-items:center;justify-content:center}
.feedback-item .delete-btn:hover{color:var(--gap)}
.feedback-empty{color:var(--sub);font-size:12px;text-align:center;padding:20px 8px}
