.feedback-input-row textarea:focus{outline:2px solid var(--ok);outline-offset:-1px}
.feedback-input-row button{padding:0 12px;border:none;border-radius:6px;background:var(--ok);color:#fff;font-weight:700;font-size:12px;cursor:pointer;flex:none}
