<script>
function downloadReport(){
  // Overlay 숨기기
  var saveProgress = document.getElementById('saveProgress');
  if (saveProgress) {
    saveProgress.style.display = 'none';
  }

  var html = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
  var blob = new Blob([html], {type: 'text/html;charset=utf-8'});
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url;
  a.download = '{{ header.name }}_보장분석리포트.html';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);

  // Overlay 복구
  if (saveProgress) {
    saveProgress.style.display = '';
  }
}

function downloadReportWithProgress(){
  var btn = document.getElementById('downloadBtn');
  var progress = document.getElementById('saveProgress');
  var message = document.getElementById('progressMessage');

  if (!btn || !progress) return;

  btn.disabled = true;
  btn.classList.add('loading');
  progress.classList.add('show');
  message.textContent = '리포트 생성 중...';

  setTimeout(function(){
    message.textContent = '저장 중...';
  }, 500);

  setTimeout(function(){
    message.textContent = '완료!';

    // Hide overlay before capturing HTML
    var overlay = progress.parentElement;
    overlay.style.display = 'none';

    var html = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
    var blob = new Blob([html], {type: 'text/html;charset=utf-8'});
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = '{{ header.name }}_보장분석리포트.html';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    // Restore overlay
    overlay.style.display = '';

    setTimeout(function(){
      btn.disabled = false;
      btn.classList.remove('loading');
      progress.classList.remove('show');
      message.textContent = '리포트 생성 중...';
    }, 800);
  }, 1200);
}

function showShareToast(msg){
  var t = document.getElementById('shareToast');
  if (!t) return;
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(function(){ t.classList.remove('show'); }, 3200);
}

async function shareReport(){
  var btn = document.getElementById('shareBtn');
  if (!btn) return;
  var url = btn.dataset.url;
  var title = btn.dataset.title;
  if (!url) {
    try {
      var resp = await fetch('/reports/' + btn.dataset.reportId + '/share', {
        method: 'POST',
        headers: {'Accept': 'application/json'},
      });
      var data = await resp.json();
      url = data.url;
      btn.dataset.url = url;
    } catch (e) {
      showShareToast('공유 링크 생성에 실패했습니다.');
      return;
    }
  }
  if (window.Kakao && window.Kakao.isInitialized && window.Kakao.isInitialized()) {
    window.Kakao.Share.sendDefault({
      objectType: 'text',
      text: title + '\n\n' + url,
      link: {mobileWebUrl: url, webUrl: url},
    });
    return;
  }
  if (navigator.share) {
    try {
      await navigator.share({title: title, url: url});
      return;
    } catch (e) {
      return; // 사용자가 공유를 취소한 경우 등 — 별다른 처리 없이 종료
    }
  }
  try {
    await navigator.clipboard.writeText(url);
    showShareToast('링크가 복사되었습니다. 카카오톡에 붙여넣어 보내주세요.');
  } catch (e) {
    window.prompt('아래 링크를 복사해서 카카오톡으로 보내주세요.', url);
  }
}

document.getElementById('shareBtn')?.addEventListener('click', shareReport);

(function(){
  var fab = document.getElementById('chatFab');
  if (!fab) return;
  var panel = document.getElementById('chatPanel');
  var body = document.getElementById('chatBody');
  var empty = document.getElementById('chatEmpty');
  var input = document.getElementById('chatInput');
  var sendBtn = document.getElementById('chatSend');
  var endpoint = "{{ chat_endpoint }}";
  var history = [];
  var busy = false;

  function toggle(open){
    panel.classList.toggle('open', open);
    if (open) input.focus();
  }
  fab.addEventListener('click', function(){ toggle(!panel.classList.contains('open')); });
  document.getElementById('chatClose').addEventListener('click', function(){ toggle(false); });

  function addMsg(role, text){
    if (empty) { empty.remove(); empty = null; }
    var el = document.createElement('div');
    el.className = 'chat-msg ' + role;
    el.textContent = text;
    body.appendChild(el);
    body.scrollTop = body.scrollHeight;
    return el;
  }

  async function send(){
    var q = input.value.trim();
    if (!q || busy) return;
    busy = true;
    sendBtn.disabled = true;
    addMsg('user', q);
    input.value = '';
    var typing = addMsg('typing', '답변 작성 중…');
    try {
      var resp = await fetch(endpoint, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({question: q, history: history}),
      });
      var payload = await resp.json();
      typing.remove();
      if (!resp.ok || payload.error) {
        addMsg('err', payload.error || '답변 생성에 실패했습니다.');
      } else {
        addMsg('bot', payload.answer);
        history.push({role: 'user', content: q});
        history.push({role: 'assistant', content: payload.answer});
        if (history.length > 16) history = history.slice(-16);
      }
    } catch (e) {
      typing.remove();
      addMsg('err', '네트워크 오류로 답변을 가져오지 못했습니다.');
    } finally {
      busy = false;
      sendBtn.disabled = false;
    }
  }
  sendBtn.addEventListener('click', send);
  input.addEventListener('keydown', function(e){ if (e.key === 'Enter') send(); });
})();

(function(){
  var fab = document.getElementById('feedbackFab');
  if (!fab) return;
  var panel = document.getElementById('feedbackPanel');
  var list = document.getElementById('feedbackList');
  var empty = document.getElementById('feedbackEmpty');
  var textarea = document.getElementById('feedbackInput');
  var sendBtn = document.getElementById('feedbackSend');
  var reportId = {{ report_id }};
  var userRole = '{{ user.role if user else "" }}';
  var busy = false;

  function toggle(open){
    panel.classList.toggle('open', open);
    if (open) loadFeedback();
  }

  fab.addEventListener('click', function(){ toggle(!panel.classList.contains('open')); });
  document.getElementById('feedbackClose').addEventListener('click', function(){ toggle(false); });

  async function loadFeedback(){
    try {
      var resp = await fetch('/reports/' + reportId + '/feedback');
      var feedbacks = await resp.json();
      list.innerHTML = '';
      empty = null;
      if (feedbacks.length === 0) {
        empty = document.createElement('div');
        empty.className = 'feedback-empty';
        empty.id = 'feedbackEmpty';
        empty.textContent = '아직 피드백이 없습니다';
        list.appendChild(empty);
      } else {
        feedbacks.forEach(function(fb){
          var item = document.createElement('div');
          item.className = 'feedback-item';
          var date = new Date(fb.created_at);
          var time = date.toLocaleDateString('ko-KR') + ' ' + date.toLocaleTimeString('ko-KR', {hour: '2-digit', minute:'2-digit'});
          var resolvedText = fb.resolved_at ? '<div style="font-size:11px;color:#1D5BD8;margin-top:6px">✓ 반영 완료 (' + escapeHtml(fb.resolved_by_user_name || '관리자') + ')</div>' : '';
          var adminCheckbox = userRole === 'admin' ? '<label style="font-size:11px;margin-top:6px;display:flex;align-items:center;gap:4px"><input type="checkbox" class="resolve-check" ' + (fb.resolved_at ? 'checked' : '') + '> 반영 완료</label>' : '';
          item.innerHTML = '<span>' + escapeHtml(fb.content) + '</span><div class="time">' + time + (fb.user_name ? ' · ' + escapeHtml(fb.user_name) : '') + '</div>' + resolvedText + adminCheckbox + '<button class="delete-btn" title="삭제">✕</button>';
          item.dataset.feedbackId = fb.id;
          var deleteBtn = item.querySelector('.delete-btn');
          deleteBtn.addEventListener('click', function(){ deleteFeedback(fb.id, item); });
          if (userRole === 'admin') {
            var checkbox = item.querySelector('.resolve-check');
            checkbox.addEventListener('change', function(){ toggleResolve(fb.id, this.checked); });
          }
          list.appendChild(item);
        });
      }
      list.scrollTop = list.scrollHeight;
    } catch (e) {
      console.error('피드백 로드 실패:', e);
    }
  }

  async function addFeedback(){
    var content = textarea.value.trim();
    if (!content || busy) return;
    busy = true;
    sendBtn.disabled = true;
    try {
      var resp = await fetch('/reports/' + reportId + '/feedback', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({content: content}),
      });
      if (!resp.ok) {
        var err = await resp.json();
        alert(err.error || '피드백 등록에 실패했습니다');
        return;
      }
      textarea.value = '';
      loadFeedback();
    } catch (e) {
      alert('피드백 등록 중 오류가 발생했습니다: ' + e.message);
    } finally {
      busy = false;
      sendBtn.disabled = false;
    }
  }

  async function deleteFeedback(feedbackId, element){
    if (!confirm('이 피드백을 삭제하시겠습니까?')) return;
    try {
      var resp = await fetch('/reports/' + reportId + '/feedback/' + feedbackId, {
        method: 'DELETE',
      });
      if (!resp.ok) throw new Error('삭제 실패');
      element.remove();
      if (list.children.length === 0) {
        empty = document.createElement('div');
        empty.className = 'feedback-empty';
        empty.id = 'feedbackEmpty';
        empty.textContent = '아직 피드백이 없습니다';
        list.appendChild(empty);
      }
    } catch (e) {
      alert('피드백 삭제에 실패했습니다: ' + e.message);
    }
  }

  async function toggleResolve(feedbackId, isResolved){
    var endpoint = isResolved ? 'resolve' : 'unresolve';
    try {
      var resp = await fetch('/reports/' + reportId + '/feedback/' + feedbackId + '/' + endpoint, {
        method: 'POST',
      });
      if (!resp.ok) throw new Error('상태 변경 실패');
      loadFeedback();
    } catch (e) {
      alert('피드백 반영 완료 상태 변경에 실패했습니다: ' + e.message);
      loadFeedback();
    }
  }

  function escapeHtml(text) {
    var div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  sendBtn.addEventListener('click', addFeedback);
  textarea.addEventListener('keydown', function(e){
    if (e.key === 'Enter' && e.ctrlKey) addFeedback();
  });
})();

// 보장 내용 삭제 및 수정 기능
document.addEventListener('DOMContentLoaded', function(){
  document.querySelectorAll('.coverage-item').forEach(function(item){
    var deleteBtn = item.querySelector('.delete-coverage-btn');
    var editBtn = item.querySelector('.edit-amount-btn');
    var amountDiv = item.querySelector('.coverage-amount');
    var amountDisplay = item.querySelector('.amount-display');
    var amountEdit = item.querySelector('.amount-edit');
    var editSaveBtn = item.querySelector('.amount-edit-btn');
    var editCancelBtn = item.querySelector('.amount-cancel-btn');

    // 삭제 버튼
    if (deleteBtn) {
      deleteBtn.addEventListener('click', function(){
        if (confirm('이 보장 항목을 삭제하시겠습니까?')) {
          item.style.opacity = '0.5';
          deleteBtn.disabled = true;
          editBtn.disabled = true;
          item.style.pointerEvents = 'none';
          item.dataset.deleted = 'true';
        }
      });
    }

    // 수정 버튼
    if (editBtn) {
      editBtn.addEventListener('click', function(){
        amountDisplay.style.display = 'none';
        amountEdit.style.display = 'inline-block';
        editSaveBtn.style.display = 'inline-block';
        editCancelBtn.style.display = 'inline-block';
        editBtn.style.display = 'none';
        deleteBtn.style.display = 'none';
        amountEdit.focus();
      });
    }

    // 저장 버튼
    if (editSaveBtn) {
      editSaveBtn.addEventListener('click', function(){
        var newValue = amountEdit.value.trim();
        if (newValue) {
          amountDisplay.textContent = newValue;
          amountDisplay.style.display = 'inline';
          amountEdit.style.display = 'none';
          editSaveBtn.style.display = 'none';
          editCancelBtn.style.display = 'none';
          editBtn.style.display = 'inline-block';
          deleteBtn.style.display = 'inline-block';
        }
      });
    }

    // 취소 버튼
    if (editCancelBtn) {
      editCancelBtn.addEventListener('click', function(){
        amountEdit.value = amountDisplay.textContent;
        amountDisplay.style.display = 'inline';
        amountEdit.style.display = 'none';
        editSaveBtn.style.display = 'none';
        editCancelBtn.style.display = 'none';
        editBtn.style.display = 'inline-block';
        deleteBtn.style.display = 'inline-block';
      });
    }
  });
});
</script>
