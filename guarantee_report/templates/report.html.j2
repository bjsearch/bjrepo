<body>
{% if not is_public_view %}<a class="back-link" href="/reports">← 저장된 리포트</a>{% endif %}
<div class="action-bar">
  {% if not is_public_view %}
  <a class="download-btn" href="/reports/{{ report_id }}/coverage-summary" style="text-decoration:none;display:inline-flex;align-items:center;gap:7px;padding:11px 20px">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M2 12h20"/><circle cx="12" cy="12" r="1"/></svg>
    <span>담보보장 요약</span>
  </a>
  <button class="share-btn" type="button" id="shareBtn" data-report-id="{{ report_id }}" data-title="{{ header.name }}님 Team DIN 보장분석기 리포트" data-url="{{ share_url or '' }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.6" y1="10.5" x2="15.4" y2="6.5"/><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"/></svg>
    <span>카카오톡으로 보내기</span>
  </button>
  {% endif %}
  <button class="download-btn" type="button" id="downloadBtn" onclick="downloadReportWithProgress()">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M5 21h14"/></svg>
    <span>완성된 리포트 저장</span>
  </button>
  <div class="save-progress" id="saveProgress">
    <div class="spinner"></div>
    <div class="message" id="progressMessage">리포트 생성 중...</div>
  </div>
</div>
<div class="share-toast" id="shareToast"></div>
{% if chat_enabled %}
<button class="chat-fab" type="button" id="chatFab" title="리포트에 대해 질문하기">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
</button>
<div class="chat-panel" id="chatPanel">
  <div class="chat-head">
    <div><b>리포트 챗봇</b><span>{{ header.name }}님 리포트 내용을 근거로 답변해요</span></div>
    <button class="chat-close" type="button" id="chatClose">✕</button>
  </div>
  <div class="chat-body" id="chatBody">
    <div class="chat-empty" id="chatEmpty">예: "실비 보장이 충분한가요?", "가장 시급한 보완은 뭐예요?"</div>
  </div>
  <div class="chat-input-row">
    <input type="text" id="chatInput" placeholder="리포트에 대해 질문해보세요" maxlength="500">
    <button type="button" id="chatSend">전송</button>
  </div>
</div>
{% endif %}
{% if not is_public_view %}
<button class="feedback-fab" type="button" id="feedbackFab" title="의견/수정사항 입력">📝</button>
<div class="feedback-panel" id="feedbackPanel">
  <div class="feedback-head">
    <div><b>피드백</b><span>리포트에 대한 의견을 남겨보세요</span></div>
    <button class="feedback-close" type="button" id="feedbackClose">✕</button>
  </div>
  <div class="feedback-list" id="feedbackList">
    <div class="feedback-empty" id="feedbackEmpty">아직 피드백이 없습니다</div>
  </div>
  <div class="feedback-input-row">
    <textarea id="feedbackInput" placeholder="피드백을 입력하세요" maxlength="500"></textarea>
    <button type="button" id="feedbackSend">등록</button>
  </div>
</div>
{% endif %}
<div class="page">

<!-- 첫번째 페이지: 표지 -->
<div class="cover" style="position:relative;padding:0;min-height:100vh;display:flex;background:#fff;overflow:hidden;page-break-after:always">
  <!-- 좌측 콘텐츠 영역 -->
  <div style="flex:1;padding:60px 80px;display:flex;flex-direction:column;justify-content:space-between;position:relative;z-index:10">
    <!-- 로고 -->
    <div style="display:flex;align-items:center;gap:12px">
      <svg viewBox="0 0 40 40" width="32" height="32">
        <path d="M4 21 A16 15 0 0 1 36 21 Z" fill="#1D5BD8"/>
        <rect x="9" y="21" width="4.4" height="6" rx="1.6" fill="#1D5BD8"/>
        <rect x="17.8" y="21" width="4.4" height="10" rx="1.6" fill="#1D5BD8"/>
        <rect x="26.6" y="21" width="4.4" height="14" rx="1.6" fill="#1D5BD8"/>
      </svg>
      <span style="font-size:18px;font-weight:900;letter-spacing:.05em;color:#000">TEAM DIN</span>
    </div>

    <!-- 메인 콘텐츠 -->
    <div style="flex:1;display:flex;flex-direction:column;justify-content:center">
      <!-- 파란색 라인 -->
      <div style="width:50px;height:3px;background:#1D5BD8;margin-bottom:32px"></div>

      <!-- 고객명 서브타이틀 -->
      <div style="font-size:18px;color:#1D5BD8;margin-bottom:20px;font-weight:700;letter-spacing:.02em">
        {{ header.name }} 고객님만을 위한
      </div>

      <!-- 메인 제목 -->
      <h1 style="font-size:84px;font-weight:900;color:#000;margin:0;margin-bottom:32px;letter-spacing:-.02em;line-height:1;font-family:'Noto Serif KR',serif">
        보장분석<br>리포트
      </h1>

      <!-- 파란색 라인 -->
      <div style="width:50px;height:3px;background:#1D5BD8;margin-bottom:32px"></div>

      <!-- 설명 텍스트 -->
      <p style="font-size:15px;color:#000;margin:0;max-width:450px;line-height:1.8;margin-bottom:0;font-weight:500">
        <span style="color:#1D5BD8;font-weight:700">TEAM DIN</span>이 꼼꼼하게 분석하고,<br>꼭 필요한 보장을 제안해드립니다.
      </p>
    </div>

    <!-- 좌측 하단 로고 -->
    <div>
      <div style="font-size:16px;font-weight:900;color:#000;letter-spacing:.02em;margin-bottom:4px">TEAM DIN</div>
      <div style="font-size:11px;letter-spacing:.08em;color:#999;font-weight:600">INSURANCE SOLUTION</div>
    </div>
  </div>

  <!-- 우측 기하학적 배경 -->
  <div style="flex:1;position:relative;background:linear-gradient(135deg,#f5f5f5 0%,#ffffff 100%);display:flex;align-items:center;justify-content:center;overflow:hidden">
    <!-- 회색 줄무늬 배경 -->
    <svg style="position:absolute;top:0;right:0;width:100%;height:100%;opacity:0.15" viewBox="0 0 400 600" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="lines" x="0" y="0" width="20" height="600" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="600" stroke="#999" stroke-width="2"/>
        </pattern>
      </defs>
      <rect width="400" height="600" fill="url(#lines)"/>
    </svg>

    <!-- 기하학적 도형 -->
    <svg style="position:absolute;width:600px;height:600px;right:-100px;top:50%;transform:translateY(-50%)" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
      <!-- 블루 원 -->
      <circle cx="200" cy="200" r="180" fill="#1D5BD8" opacity="0.9"/>

      <!-- 검은색 다각형 -->
      <polygon points="200,200 400,400 200,400" fill="#0F1419" opacity="0.95"/>

      <!-- 밝은 블루 원호 -->
      <circle cx="200" cy="200" r="180" fill="none" stroke="#4A90FF" stroke-width="2" opacity="0.3"/>
    </svg>

    <!-- 우측 하단 텍스트 박스 -->
    <div style="position:absolute;bottom:60px;right:60px;text-align:right;z-index:20">
      <div style="font-size:13px;letter-spacing:.12em;color:#666;font-weight:600;text-transform:uppercase;line-height:2">
        Insurance<br>Solution
      </div>
      <div style="width:40px;height:2px;background:#1D5BD8;margin-top:8px"></div>
    </div>
  </div>
</div>

<!-- 두번째 페이지: 계약현황 -->
<div class="section-page">
<header>
  <div class="eyebrow">Insurance Coverage Analysis Report</div>
  <h1><span class="name serif">{{ header.name }}</span> 님 Team DIN 보장분석기 리포트</h1>
  <div class="meta">
    <span>피보험자 <b>{{ header.name }} ({{ header.gender }}, {{ header.birth_display }}{% if header.age %} · 보험나이 {{ header.age }}세{% endif %})</b></span>
    <span>분석 기준 <b>{{ header.basis_date_display }} 발행 Team DIN 보장분석기</b></span>
    <span>생성일시 <b>{{ created_datetime or header.basis_date_display }}</b></span>
    <span>계약 <b>총 {{ header.total_contracts }}건 (생보 {{ header.life_count }} · 손보 {{ header.nonlife_count }} · 기타 {{ header.coop_count }})</b></span>
  </div>
</header>

<div class="brands">
  {% for b in brands_legend %}
  <span class="brand">{{ b.logo_html|safe }}<b>{{ b.name }}</b>&nbsp;{{ b.count_label }}</span>
  {% endfor %}
</div>

<div class="kpis">
  <div class="kpi hl"><div class="label">월 납입 보험료</div><div class="value num">{{ kpis.monthly_premium }}<span class="unit">원</span></div></div>
  <div class="kpi"><div class="label">총 보험료</div><div class="value num">{{ kpis.grand_total_man }}<span class="unit">천만원</span></div></div>
  <div class="kpi"><div class="label">납입한 보험료</div><div class="value num">{{ kpis.paid_total_man }}<span class="unit">천만원</span></div></div>
  <div class="kpi" style="background:white"><div class="label">잔여보험료</div><div class="value num" style="color:red">{{ kpis.scheduled_total_man }}<span class="unit">천만원</span></div></div>
</div>
</div>

<!-- 기존 hero 일러스트 제거 -->
<div class="hero" style="display:none">
<svg viewBox="0 0 800 210" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="우산 아래 함께 있는 가족 일러스트">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFF3E4"/><stop offset="1" stop-color="#FFE4CC"/>
    </linearGradient>
  </defs>
  <rect width="800" height="210" fill="url(#sky)"/>
  <circle cx="700" cy="46" r="26" fill="#FFD98E"/>
  <circle cx="700" cy="46" r="36" fill="#FFD98E" opacity=".28"/>
  <ellipse cx="120" cy="46" rx="42" ry="14" fill="#FFFFFF" opacity=".85"/>
  <ellipse cx="158" cy="56" rx="30" ry="11" fill="#FFFFFF" opacity=".7"/>
  <ellipse cx="560" cy="36" rx="36" ry="12" fill="#FFFFFF" opacity=".75"/>
  <ellipse cx="400" cy="270" rx="520" ry="105" fill="#F7CFA6"/>
  <ellipse cx="640" cy="285" rx="380" ry="110" fill="#F2BE8C" opacity=".7"/>
  <g transform="translate(590,92)">
