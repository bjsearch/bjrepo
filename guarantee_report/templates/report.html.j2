.action-bar button:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(16,35,63,.35)}
.action-bar button svg{width:17px;height:17px;flex:none}
.action-bar a{display:inline-flex;align-items:center;gap:8px;padding:14px 28px;font-size:14px;font-weight:700;text-decoration:none;border-radius:99px;box-shadow:0 4px 14px rgba(16,35,63,.28);transition:transform .15s,box-shadow .15s}
.action-bar a:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(16,35,63,.35)}
.action-bar a svg{width:17px;height:17px;flex:none}
.download-btn{background:var(--ink);color:#fff}
.share-btn{background:#FEE500;color:#3C1E1E}
@media(max-width:768px){.action-bar{top:auto;bottom:20px;right:20px;flex-direction:column;gap:12px}.action-bar button,.action-bar a{padding:14px 20px;font-size:13px}.action-bar button span,.action-bar a span{display:inline}.action-bar button svg,.action-bar a svg{width:16px;height:16px}}
@media(max-width:640px){.action-bar{top:auto;bottom:16px;right:16px;flex-direction:column;gap:10px}.action-bar button,.action-bar a{padding:12px 16px;font-size:12px;border-radius:8px}.action-bar button span,.action-bar a span{display:none}.action-bar button svg,.action-bar a svg{width:18px;height:18px}}
